<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootSplash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:paddingHorizontal="24dp">

    <!-- Top Badge Header (Respects Top Insets) -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_status_dot_live" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.06"
                android:text="CAMPUS MOBILITY"
                android:textColor="@color/secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="NMIMS"
            android:textColor="@color/secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Center Hero Section -->
    <LinearLayout
        android:id="@+id/layoutCenterHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomFooter"
        app:layout_constraintTop_toBottomOf="@id/layoutTopHeader"
        app:layout_constraintVertical_bias="0.48">

        <!-- Logo Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLogo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/subtle_divider"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivSplashLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/enroute_logo" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Brand Title -->
        <TextView
            android:id="@+id/tvBrandTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02"
            android:text="ENROUTE"
            android:textColor="@color/primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvBrandSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.14"
            android:text="NMIMS CAMPUS TRANSPORT"
            android:textColor="@color/secondary"
            android:textSize="11sp" />

        <!-- Subtle Sage Accent Status Pill -->
        <LinearLayout
            android:id="@+id/layoutStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_bento_accent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_status_dot_live" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="Transit Fleet Online"
                android:textColor="@color/on_secondary_container"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tasteful Loading Progress Indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressLoading"
            android:layout_width="120dp"
            android:layout_height="3dp"
            android:layout_marginTop="28dp"
            android:indeterminate="true"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/subtle_divider"
            app:trackCornerRadius="2dp" />

    </LinearLayout>

    <!-- Bottom Footer Section (Respects Bottom Insets) -->
    <LinearLayout
        android:id="@+id/layoutBottomFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Mukesh Patel School of Technology Management &amp; Engineering"
            android:textColor="@color/secondary"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.04"
            android:text="NMIMS DEEMED-TO-BE-UNIVERSITY"
            android:textColor="@color/secondary"
            android:textSize="9sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
